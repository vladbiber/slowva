<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_cava_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp">

    <ImageView
        android:id="@+id/widget_cava_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_cava_description"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/widget_cava_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="@string/widget_cava_title"
            android:textColor="#FFF8FF"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/widget_cava_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#E6000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="@string/widget_connect_hint"
            android:textColor="#D9E9DFF0"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_cava_previous"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/previous"
                android:gravity="center"
                android:text="@string/symbol_previous"
                android:textColor="#FFF8FF"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/widget_cava_play"
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/play_pause"
                android:gravity="center"
                android:text="@string/symbol_play"
                android:textColor="#FFE0B8FF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/widget_cava_next"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/next"
                android:gravity="center"
                android:text="@string/symbol_next"
                android:textColor="#FFF8FF"
                android:textSize="28sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
