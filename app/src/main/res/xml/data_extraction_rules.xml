<?xml version="1.0" encoding="utf-8"?>
<!-- the ListenBrainz token stays on this phone -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="slowva-listenbrainz.xml" />
        <exclude domain="file" path="listenbrainz-queue.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="slowva-listenbrainz.xml" />
        <exclude domain="file" path="listenbrainz-queue.json" />
    </device-transfer>
</data-extraction-rules>
